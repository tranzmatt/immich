# Immich as reachable from inside the companion container.
IMMICH_URL=http://host.docker.internal:2283

# Create this in Immich with asset.read permission. Do not commit the value.
IMMICH_API_KEY=

# Separate login protecting the companion UI on your LAN.
APP_USERNAME=
APP_PASSWORD=

# Host/LAN port. The service binds to every host interface.
EXACT_DUPLICATES_PORT=3210

# Keep this low for network-mounted libraries.
HASH_CONCURRENCY=2
